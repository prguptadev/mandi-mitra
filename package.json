{
  "name": "mandi-mitra",
  "private": true,
  "version": "0.3.16",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "db:push": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "build:desktop-server": "node scripts/build-desktop-server.mjs",
    "desktop:pack": "npm run build && npm run build:desktop-server && electron-builder --win --publish never",
    "tally:check": "tsx scripts/tally-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tanstack/react-query": "^5.62.7",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.2",
    "exceljs": "^4.4.0",
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "uuidv7": "^1.0.2",
    "wouter": "^3.3.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.6",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "main": "electron/main.cjs",
  "description": "Mandi Mitra — daily list, OCR, stock, kaccha parcha and accounts for a grain commission agent",
  "author": "Vijay Laxmi Dal Mill"
}
